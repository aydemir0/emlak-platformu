{
  "name": "emlak-platformu",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"tests/**/*.{ts,tsx}\" \"*.{json,js,mjs,ts}\" \".github/**/*.yml\" \"docs/architecture/application-foundation.md\" \"docs/requirements/production-hardening-release-readiness.md\" \"docs/decisions/ADR-015-production-release-readiness.md\" \"docs/database/retention-deletion.md\" \"docs/operations/*.md\" \"docs/superpowers/{plans,specs}/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\" \"tests/**/*.{ts,tsx}\" \"*.{json,js,mjs,ts}\" \".github/**/*.yml\" \"docs/architecture/application-foundation.md\" \"docs/requirements/production-hardening-release-readiness.md\" \"docs/decisions/ADR-015-production-release-readiness.md\" \"docs/database/retention-deletion.md\" \"docs/operations/*.md\" \"docs/superpowers/{plans,specs}/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:types": "tsc --noEmit --pretty false",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1106.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "shadcn": "4.16.2",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
