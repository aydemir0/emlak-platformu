# Browser-visible configuration. The anon key is public but remains RLS/grant constrained.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never log this value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only local PostgreSQL connection. Phase 5 rejects non-loopback hosts and any port other than 55322.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
