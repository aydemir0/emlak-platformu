# Browser-visible configuration. The anon key is public but remains RLS/grant constrained.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never log this value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, independently rotatable HMAC key for public lead idempotency and abuse signals.
# Use at least 32 random characters. Never reuse the Supabase service role key.
LEAD_INTAKE_HMAC_SECRET=

# Phase 8 configurable security defaults. Review before production launch.
LEAD_RATE_LIMIT_MAX_ATTEMPTS=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=900
MATCHING_CANDIDATE_LIMIT=500

# Server-only local PostgreSQL connection. Phase 5 rejects non-loopback hosts and any port other than 55322.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Optional Phase 6 R2 group. Leave every value empty for deterministic local/test storage.
# Never prefix these with NEXT_PUBLIC_ and never commit real credentials.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
