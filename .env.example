# Required production non-secrets.
# Keep these local values in developer/test environments. Configure production values
# only in the deployment environment; do not copy production bindings into local files.
APP_ENV=local
APP_BASE_URL=http://localhost:3000
APP_RELEASE=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=

# Required production secrets. Leave DATABASE_URL empty locally. Never prefix these
# variables with NEXT_PUBLIC_, commit real values, or print them in logs/errors.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_INTAKE_HMAC_SECRET=
CRON_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional production values with bounded defaults.
LEAD_RATE_LIMIT_MAX_ATTEMPTS=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=900
MATCHING_CANDIDATE_LIMIT=500

# Local/test only. APP_ENV=local or test rejects DATABASE_URL and requires this
# loopback Supabase database. APP_ENV=preview or production rejects this variable.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# R2 is optional in local/preview, forbidden in test, and required as a complete
# four-variable group in production. Test uses deterministic in-memory media storage.
